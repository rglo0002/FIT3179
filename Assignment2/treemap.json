{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Heatmap of Satellite Category and Purpose",
    "data": {
      "url": "https://raw.githubusercontent.com/rglo0002/FIT3179/main/clean_sat_data.csv"
    },
    "mark": "rect",
    "encoding": {
      "x": {
        "field": "Category",
        "type": "nominal",
        "title": "Category",
        "axis": {"labelAngle": -45}
      },
      "y": {
        "field": "Grouped_Purpose",
        "type": "nominal",
        "title": "Purpose"
      },
      "color": {
        "aggregate": "count",
        "type": "quantitative",
        "title": "Count",
        "scale": {
          "scheme": "blues"
        }
      },
      "tooltip": [
        {"field": "Category", "type": "nominal"},
        {"field": "Purpose", "type": "nominal"},
        {"aggregate": "count", "type": "quantitative", "title": "Count"}
      ]
    }
  }
  