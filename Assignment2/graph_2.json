{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
      "text": "Total Satellites by Country/Organization",
      "font": "monospace",
      "fontSize": 16,
      "color": "white"
    },
    "data": {
      "url": "https://raw.githubusercontent.com/rglo0002/FIT3179/main/unmatched_countries_organisations.csv"
    },
    "background": "#010c12",
    "config": {
      "text": {"fill": "white"},
      "axis": {
        "labelColor": "white",
        "titleColor": "white"
      },
      "legend": {
        "labelColor": "white",
        "titleColor": "white",
        "labelFont": "monospace",
        "titleFont": "monospace"
      }
    },
    "mark": "bar",
    "encoding": {
      "x": {
        "field": "Countries_Organisations",
        "type": "nominal",
        "axis": {
          "labelAngle": -45
        }
      },
      "y": {
        "field": "Total_Satellites",
        "type": "quantitative"
      },
      "color": {
        "field": "Total_Mass",
        "type": "quantitative",
        "scale": {
          "domain": [0, 10000, 20000, 30000],
          "range": ["#ffb3b3", "#ff6666", "#ff3333", "#cc0000"]
        }
      },
      "tooltip": [
        {"field": "Countries_Organisations", "type": "nominal"},
        {"field": "Total_Satellites", "type": "quantitative"},
        {"field": "Total_Mass", "type": "quantitative", "format": ","}
      ]
    }
  }
  