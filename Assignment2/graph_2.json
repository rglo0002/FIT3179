{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
      "text": "Mulitple Country/Organisation Satellites",
      "font": "monospace",
      "fontSize": 16,
      "color": "white"
    },
    "width": 430,
    "data": {
      "url": "https://raw.githubusercontent.com/rglo0002/FIT3179/main/unmatched_countries_organisations.csv"
    },
    "background": "#010c12",
    "config": {
      "text": {"fill": "white"},
      "axis": {
        "labelColor": "white",
        "titleColor": "white"
      },
      "legend": {
        "labelColor": "white",
        "titleColor": "white",
        "labelFont": "monospace",
        "titleFont": "monospace"
      }
    },
    "mark": "bar",
    "encoding": {
      "x": {
        "field": "Countries/Organisations",
        "type": "nominal",
        "axis": {
          "labelAngle": -45
        }
      },
      "y": {
        "field": "Total_Satellites",
        "type": "quantitative",
        "title": "Total Satellites"
      },
      "color": {
        "field": "Total_Mass",
        "title": "Total Mass (kg)",
        "type": "quantitative",
        "scale": {
          "type": "log",
            "scheme": "viridis"
        }
      },
      "tooltip": [
        {"field": "Countries/Organisations", "type": "nominal"},
        {"field": "Total_Satellites", "type": "quantitative", "format": ",", "title": "Total Satellites"},
        {"field": "Total_Mass", "type": "quantitative", "format": ",", "title": "Total Mass (kg)"}
      ]
    }
  }
  