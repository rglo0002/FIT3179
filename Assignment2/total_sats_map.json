{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",  
  "title": "Total Satellites by Country",
    "width": "container",    
    "height": "container",
    "background": "#010c12",
    "config": {
      "text": {"fill": "white"},  
      "title": {"color": "white", "font": "monospace", "fontSize": 16}, 
      "legend": {"labelColor": "white", "titleColor": "white", "labelFont": "monospace", "titleFont": "monospace"} 
    },
    "projection": {"type": "equalEarth"},
    "layer": [
      {
        "data": {
          "sphere": true
        },
        "mark": {
          "type": "geoshape",
          "fill": "#1699e0",
          "stroke": null
        }
      },
      {
        "data": {
          "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/WorldMapWithGraticules.topojson",
          "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
        },
        "mark": {"type": "geoshape", "fill": "green", "stroke": "white"}
      },
      {
        "data": {
          "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/WorldMapWithGraticules.topojson",
          "format": {"type": "topojson", "feature": "ne_110m_graticules_30"}
        },
        "mark": {"type": "geoshape", "fill": null, "stroke": "lightgray"}
      },
      {
        "data": {
          "url": "https://raw.githubusercontent.com/rglo0002/FIT3179/main/merged_sat_data.csv"
        },
        "transform": [{"filter": "datum.Total_Satellites > 0"}],
        "mark": 
        {
          "type": "circle"
        },
        "encoding": {
          "longitude": {"field": "Longitude", "type": "quantitative"},
          "latitude": {"field": "Latitude", "type": "quantitative"},
          "size": {
            "field": "Total_Satellites",
            "type": "quantitative",
            "title": "Total Satellites",
            "scale": {
              "domain": [1, 10, 50, 100, 1000, 5000],  
              "range": [30, 100, 200, 300, 800, 2000]     
            },
            "legend": {
              "title": "Total Satellites",
              "values": [1, 10, 100, 1000, 5000],  
              "labelExpr": "datum.value == 1 ? '1-10' : datum.value == 10 ? '10-50' : datum.value == 50 ? '10-50' : datum.value == 100 ? '50-100' : datum.value == 1000 ? '100-1000' : '1000+'",
              "orient": "bottom-left",
              "offset": 70
            }
          },
          "color": {
          "field": "Total_Satellites",
          "type": "quantitative",
          "title": "Total Satellites",
          "scale": {
            "domain": [1, 10, 50, 100, 1000, 5000],
            "range": ["#fee0d2", "#fc9272", "#ef3b2c", "#cb181d", "#a50f15", "#67000d"] 
          }
        },
          "opacity": {"value": 0.9},
          "tooltip": 
          [
            {"field": "Country", "type": "nominal"},
            {"field": "Total_Satellites", "type": "quantitative", "title": "Total Satellites", "format": ","},
            {"field": "Total_Mass", "type": "quantitative", "title": "Total Mass (kg)", "format": ","}
          ]
        }
      }
    ]
  }